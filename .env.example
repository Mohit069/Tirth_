# Copy this file to .env and fill in the values. Never commit .env.

# ---- Database (PostgreSQL) ----
# DATABASE_URL is what the app uses. On a hosted database use its POOLED connection
# string (Supabase: "Transaction pooler", port 6543; Neon: the "-pooler" host).
# DIRECT_URL is used only for migrations (`npm run db:deploy`): the DIRECT / session
# connection string (Supabase: port 5432). Leave it empty if you only have one URL.
#
# Local: run `npm run db:local` and use
#   DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
#   SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
DATABASE_URL=""
DIRECT_URL=""
# Local `prisma dev` only (used by `npm run db:migrate`). Leave empty in production.
SHADOW_DATABASE_URL=""

# ---- Logins ----
# Counter staff PIN (use 6 or more digits) and admin password.
STAFF_PIN=""
ADMIN_PASSWORD=""

# Long random string used to sign login cookies (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# ---- Trust ----
# Trust WhatsApp number with country code, digits only.
TRUST_WHATSAPP="919216057565"

# Public address of the app, used for the printed QR code (no trailing slash).
APP_URL="https://your-app-address"

# ---- Automatic WhatsApp: optional and PAID, currently not used. Leave empty. ----
# (README: "Optional: automatic WhatsApp".) Sends the token photo to the yatri's WhatsApp and
# an alert to the trust's representative through Meta's WhatsApp Business Platform.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Representative number(s) for new-entry alerts, comma-separated. Empty = TRUST_WHATSAPP.
WHATSAPP_TEAM_NUMBERS=""
# Approved template names (these are the defaults).
WHATSAPP_YATRI_TEMPLATE="yatri_token"
WHATSAPP_TEAM_TEMPLATE="yatri_entry_alert"
# At most this many entries a day get WhatsApp messages (protects the bill from form spam).
WHATSAPP_DAILY_LIMIT="2000"

# ---- Google Sheet for management (free; README: "Google Sheet setup") ----
# Web app address of the Apps Script in the sheet (google-apps-script/Code.gs), ends in /exec.
GOOGLE_SCRIPT_URL=""
# Same long random text as SECRET in the Apps Script (16+ characters).
GOOGLE_SCRIPT_SECRET=""
# Optional: the long ID in the sheet address docs.google.com/spreadsheets/d/<ID>/edit (admin link).
GOOGLE_SHEET_ID=""
